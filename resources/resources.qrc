<RCC>
    <qresource prefix="/icons">
        <file alias="app_256.png">icons/app_256.png</file>
        <file alias="app_64.png">icons/app_64.png</file>
        <file alias="add.png">icons/add.png</file>
        <file alias="remove.png">icons/remove.png</file>
        <file alias="clear.png">icons/clear.png</file>
        <file alias="convert.png">icons/convert.png</file>
        <file alias="cancel.png">icons/cancel.png</file>
        <file alias="settings.png">icons/settings.png</file>
        <file alias="folder.png">icons/folder.png</file>
        <file alias="play.png">icons/play.png</file>
        <file alias="pause.png">icons/pause.png</file>
        <file alias="stop.png">icons/stop.png</file>
        <file alias="volume.png">icons/volume.png</file>
        <file alias="info.png">icons/info.png</file>
    </qresource>
    <qresource prefix="/legal">
        <file alias="LICENSE.txt">../LICENSE</file>
        <file alias="THIRD_PARTY_LICENSES.txt">../THIRD_PARTY_LICENSES.md</file>
    </qresource>
</RCC>
